# =============================================================================
# PharmSentinel AI - Environment Configuration Template
# Duplicate this file as '.env' and fill in your credentials.
# =============================================================================

# Google Gemini API Key (Get yours for free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Gemini Model Selection (gemini-1.5-flash | gemini-2.0-flash | gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Local HTTP Server Port
PORT=8080

# Hospital / Facility Information
HOSPITAL_FACILITY_NAME="St. Jude Memorial Health System"
ICU_WARD_NAME="Trauma & Critical Care Unit 4"

# Autonomous Restock Policies
AUTO_PILOT_SPEND_LIMIT=2500
ENABLE_AUDIO_CHIMES=true
